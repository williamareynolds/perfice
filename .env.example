# Copy to .env and fill in. `.env` is gitignored; keep it that way.
#
#   cp .env.example .env
#
# Every secret below has a generate command next to it. Run them and paste the
# output -- do not invent values by hand, and do not reuse one across two
# variables.

# ── Compose ───────────────────────────────────────────────────────────────────

# Names the containers, network and volumes. Set here rather than as a
# top-level `name:` in the compose file, which needs Compose v2.3+.
COMPOSE_PROJECT_NAME=perfice

# ── Secrets ───────────────────────────────────────────────────────────────────

# Proves a request came through the gateway.
#
# auth, sync and integration trust the `X-Userid` header without verifying it;
# this header is what stops anyone who can reach a backend port from claiming to
# be any user. All four services must be given the *same* value, and every one
# of them refuses to start without it.
#
#   openssl rand -hex 32
INTERNAL_SECRET=

# Signs session access tokens. Auth only.
# Changing it invalidates every existing login.
#
#   openssl rand -hex 32
JWT_SECRET=

# Encrypts provider OAuth tokens and fetched payloads at rest. Integration only.
#
# Must be EXACTLY 32 bytes -- the service refuses to start otherwise. The
# command below gives 32 hex characters, which is 32 bytes. Changing this makes
# everything already encrypted unreadable, so treat it as permanent.
#
#   openssl rand -hex 16
ENCRYPTION_KEY=

# RabbitMQ credentials. Only reachable inside the compose network, but it still
# should not ship with a known password.
#
#   openssl rand -hex 16
RABBITMQ_USER=perfice
RABBITMQ_PASSWORD=

# ── Public URLs ───────────────────────────────────────────────────────────────
#
# The defaults work as-is on your own machine. These are the only lines that
# change when you move to a real host.

# Where a *browser* reaches the backend. Used for OAuth callbacks and links in
# any mail the auth service sends, so it must be publicly resolvable once this
# is not localhost. Not an internal service name.
#
# The client compiles this in at build time, so changing it needs:
#   docker compose up -d --build client
PUBLIC_BACKEND_URL=http://localhost:3000

# Where a browser reaches the app itself. Note the /new suffix -- the client is
# served under that subpath.
PUBLIC_APP_URL=http://localhost/new

# Extra CORS origins, comma-separated.
#
# The gateway already allows http://localhost, https://localhost, :5173 and
# :8000. Anything else -- including a *different port on localhost* -- has to be
# listed here, or the browser blocks every backend call with a CORS error while
# the backend logs look perfectly healthy.
#
# So if you change CLIENT_PORT below, add the matching origin here.
# CORS_EXTRA_ORIGINS=https://perfice.example.com

# ── Ports ─────────────────────────────────────────────────────────────────────
#
# Host-side only. Change these if something already owns 80 or 3000. Port 80
# often needs root, so on a dev machine CLIENT_PORT=8080 is usually easier.

# CLIENT_PORT=80
# GATEWAY_PORT=3000

# ── Logging ───────────────────────────────────────────────────────────────────
#
# Standard RUST_LOG filter. `debug` is genuinely useful when an integration is
# not firing; `perfice_integration=debug,info` narrows it to one service.

# RUST_LOG=info
